{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "stories": {
            "type": "object",
            "properties": {
                "roots": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]*$"
                            },
                            "title": {
                                "type": "string"
                            },
                            "dir": {
                                "default": ".",
                                "type": "string"
                            },
                            "stories": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    }
                                ]
                            },
                            "preview": {
                                "type": "string",
                                "minLength": 1
                            },
                            "vite": {
                                "type": "string",
                                "minLength": 1
                            },
                            "static": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "from": {
                                            "type": "string"
                                        },
                                        "to": {
                                            "type": "string"
                                        }
                                    },
                                    "required": ["from", "to"]
                                }
                            },
                            "themeGlobal": {
                                "default": "theme",
                                "type": "string"
                            },
                            "guards": {
                                "type": "object",
                                "properties": {
                                    "forbidRuntimeImports": {
                                        "type": "array",
                                        "items": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "not": {}
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        },
                        "required": ["id", "stories", "preview", "vite"]
                    }
                }
            },
            "required": ["roots"]
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "prototypes": {
            "default": "src/**/*.proto.tsx",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "drafts": {
            "default": "src/drafts",
            "type": "string"
        },
        "flows": {
            "default": "flows",
            "type": "string"
        },
        "canvas": {
            "default": "proto.canvas.tsx",
            "type": "string"
        },
        "specs": {
            "anyOf": [
                {
                    "type": "object",
                    "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                {
                    "not": {}
                }
            ]
        },
        "roles": {
            "default": {},
            "type": "object",
            "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
                "type": "string"
            }
        },
        "siteUrl": {
            "type": "string",
            "format": "uri"
        },
        "locale": {
            "default": "en",
            "type": "string",
            "enum": ["en", "pt-BR"]
        },
        "guards": {
            "default": {},
            "type": "object",
            "properties": {
                "forbidRuntimeImports": {
                    "default": [],
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "not": {}
                            }
                        ]
                    }
                },
                "productionBoundary": {
                    "default": true,
                    "type": "boolean"
                }
            }
        },
        "evidence": {
            "default": {},
            "type": "object",
            "properties": {
                "dir": {
                    "default": "docs/design",
                    "type": "string"
                }
            }
        },
        "build": {
            "default": {},
            "type": "object",
            "properties": {
                "includeReview": {
                    "default": false,
                    "type": "boolean"
                }
            }
        },
        "dev": {
            "default": {},
            "type": "object",
            "properties": {
                "port": {
                    "default": 4400,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65534
                },
                "poll": {
                    "default": false,
                    "type": "boolean"
                },
                "allowedHosts": {
                    "default": [],
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9.-]+$"
                    }
                }
            }
        }
    },
    "required": ["title"]
}
