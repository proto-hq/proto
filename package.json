{
    "name": "proto-public",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check:surface": "bash scripts/check-surface.sh",
        "verify": "bun run format:check && bun run check:surface",
        "prepare": "husky",
        "postinstall": "bash scripts/postinstall.sh"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.74.0"
    },
    "lint-staged": {
        "*.{json,jsonc,yaml,yml,md}": [
            "oxfmt --no-error-on-unmatched-pattern"
        ]
    },
    "engines": {
        "bun": ">=1.4.4",
        "node": ">=24.22.1"
    },
    "packageManager": "bun@1.4.4"
}
